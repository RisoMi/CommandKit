{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CommandKit",
        "width": 1360,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 660,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 14
        },
        "backgroundColor": "#0E0F11",
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
